{
  "permissions": {
    "allow": [
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh api repos/*/pulls/*/comments/*/replies*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh secret:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api *collaborators*)",
      "Bash(gh api *hooks*)",
      "Bash(gh api *rulesets*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
