@page "/projects/new"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@inject CreateProjectHandler Handler
@inject NavigationManager Navigation

<PageTitle>New project</PageTitle>

<h1>New project</h1>

<EditForm Model="form" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <label>
        Name
        <InputText @bind-Value="form.Name" />
    </label>
    <ValidationMessage For="() => form.Name" />
    @if (error is not null)
    {
        <p role="alert">@error</p>
    }
    <button type="submit">Create</button>
    <a href="projects">Cancel</a>
</EditForm>

@code {
    private readonly FormModel form = new();
    private string? error;

    private async Task Submit()
    {
        var result = await Handler.Handle(form.Name);
        if (result.Error is not null)
        {
            error = result.Error;
            return;
        }
        Navigation.NavigateTo("projects");
    }

    private sealed class FormModel
    {
        [Required, StringLength(RotationTracker.Domain.Project.NameMaxLength)]
        public string Name { get; set; } = "";
    }
}
